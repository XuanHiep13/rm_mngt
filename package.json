{
  "name": "vm-access-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write client server scripts tests docs *.json *.ts *.yaml README.md",
    "db:migrate": "tsx scripts/migrate.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "keys:generate": "node scripts/generate-keys.mjs",
    "preview:local": "tsx scripts/local-preview.ts",
    "remote:test": "tsx scripts/remote-test.ts"
  },
  "dependencies": {
    "cookie-parser": "1.4.7",
    "dotenv": "16.6.1",
    "express": "5.1.0",
    "express-rate-limit": "8.7.3",
    "guacamole-common-js": "1.5.0",
    "helmet": "8.1.0",
    "lucide-react": "0.468.0",
    "mysql2": "3.24.6",
    "otpauth": "9.4.1",
    "qrcode": "1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tsx": "4.20.6",
    "ws": "8.22.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.3",
    "@types/node": "22.19.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/supertest": "6.0.3",
    "@types/ws": "8.18.1",
    "prettier": "3.6.2",
    "supertest": "7.1.4",
    "typescript": "5.9.3",
    "vite": "^6.4.6"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
